{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end test suites. Each suite spins up its own docker-compose stack, seeds, exercises the system, and tears down.",
  "type": "module",
  "scripts": {
    "test": "bun test --timeout 180000",
    "test:rice-shower-scrape": "bun test --timeout 180000 suites/rice-shower-scrape",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/tsdb": "workspace:*",
    "@types/bun": "^1.3.12",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.2.0",
    "postgres": "^3.4.9"
  }
}
